{
  "name": "roe.dev",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "pnpm rebuild sharp && nuxt build",
    "start": "nuxt start",
    "partykit:dev": "partykit dev ./partykit/server.ts",
    "partykit:deploy": "partykit deploy ./partykit/server.ts",
    "lint:js": "eslint .",
    "lint:style": "stylelint **/*.{vue,css} --fix --ignore-path .gitignore",
    "lint": "pnpm lint:js && pnpm lint:style",
    "test": "vitest run",
    "test:types": "nuxt prepare && vue-tsc -b --noEmit",
    "test:e2e": "playwright test test/e2e",
    "test:e2e:update": "docker run --rm --network host -v $(pwd):/work/ -v /tmp/playwright-nm:/work/node_modules -w /work/ -it mcr.microsoft.com/playwright:v1.62.1-noble bash -c 'corepack enable && pnpm i && pnpm playwright test test/e2e --update-snapshots'",
    "postinstall": "nuxt prepare && pnpm simple-git-hooks install",
    "auth:linkedin": "node --env-file=.env scripts/linkedin-auth.ts",
    "auth:youtube": "node --env-file=.env scripts/youtube-auth.ts",
    "auth:youtube:refresh": "node --env-file=.env scripts/youtube-auth.ts refresh",
    "lex:gen": "lex build --lexicons ./lexicons --out ./shared/lex --clear --index-file --import-ext .ts",
    "lex:publish": "node --env-file=.env scripts/publish-lex.ts"
  },
  "nano-staged": {
    "*.{js,ts,mjs,vue}": [
      "eslint"
    ],
    "*.{css,vue}": "stylelint"
  },
  "dependencies": {
    "@atcute/bluesky-richtext-segmenter": "^3.0.2",
    "@atproto/lex": "0.3.8",
    "@atproto/lex-password-session": "0.2.2",
    "@atproto/oauth-client-node": "0.5.4",
    "@bsky/sdk": "1.1.0",
    "@comark/nuxt": "0.6.2",
    "@formkit/drag-and-drop": "0.6.1",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify-json/tabler": "^1.2.37",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "^1.3.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/html-validator": "2.1.0",
    "@nuxtjs/plausible": "4.0.0",
    "@takumi-rs/core": "^2.5.2",
    "@unhead/vue": "3.4.0",
    "@unocss/nuxt": "66.8.1",
    "@unocss/postcss": "66.8.1",
    "@unocss/reset": "66.8.1",
    "@vercel/blob": "^2.6.1",
    "citty": "^0.2.2",
    "comark": "0.6.2",
    "comark-content": "0.3.0",
    "defu": "^6.1.7",
    "exsolve": "^1.1.1",
    "feed": "^6.0.0",
    "gsap": "^3.15.0",
    "h3": "^1.15.11",
    "image-meta": "^0.2.2",
    "knitwork": "^1.3.0",
    "magic-regexp": "0.11.0",
    "magic-string": "^1.1.0",
    "masto": "^8.0.0",
    "mediabunny": "^1.51.0",
    "mlly": "^1.8.2",
    "mocked-exports": "^0.1.1",
    "modern-screenshot": "^4.7.0",
    "multiformats": "14.0.5",
    "nuxt": "4.5.2",
    "nuxt-og-image": "6.7.8",
    "nuxt-security": "2.6.0",
    "partykit": "0.0.115",
    "partysocket": "^1.3.0",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.1",
    "postcss-nesting": "^14.0.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "scule": "^1.3.0",
    "shiki": "^4.3.1",
    "std-env": "^4.2.0",
    "tinyglobby": "^0.2.17",
    "ufo": "^1.6.4",
    "unocss": "66.8.1",
    "unplugin": "^3.3.0",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.1",
    "@types/html-to-text": "9.0.4",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.9.1",
    "googleapis": "176.0.0",
    "happy-dom": "20.11.6",
    "html-to-text": "10.0.1",
    "nano-staged": "1.0.2",
    "ofetch": "1.5.1",
    "playwright-core": "1.62.1",
    "rollup": "4.63.1",
    "simple-git-hooks": "2.14.0",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit $1",
    "pre-commit": "npx nano-staged"
  },
  "packageManager": "pnpm@11.24.0"
}
