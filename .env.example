# Required at runtime; the server will not start without these.
NUXT_ATPROTO_PASSWORD=
NUXT_GITHUB_TOKEN=
NUXT_GITHUB_CLIENT_SECRET=
NUXT_GITHUB_INVITE_TOKEN=
NUXT_TWITCH_CLIENT_ID=
NUXT_TWITCH_CLIENT_SECRET=

# Required in every environment you deploy to. Sessions seal with this, and a
# build never generates one. Generate with `openssl rand -base64 32`.
NUXT_APP_SECRET=

# Optional runtime config.
NUXT_PUBLIC_GITHUB_CLIENT_ID=
NUXT_GITHUB_PROFILE_TOKEN=
NUXT_BLOB_READ_WRITE_TOKEN=
NUXT_MASTODON_ACCESS_TOKEN=
NUXT_LINKEDIN_ACCESS_TOKEN=
NUXT_BLUESKY_ACCESS_TOKEN=
NUXT_YOUTUBE_CLIENT_ID=
NUXT_YOUTUBE_CLIENT_SECRET=
NUXT_YOUTUBE_REFRESH_TOKEN=
NUXT_PARTY_TOKEN=
NUXT_PUSHOVER_TOKEN=
NUXT_PUSHOVER_USER_KEY=
NUXT_LOCATION_API_KEY=

# The production content sync skips a provider whose token is unset.
NUXT_ADVOCU_TOKEN=
NUXT_DEV_TO_TOKEN=
NUXT_GITHUB_STARS_TOKEN=

# 32 bytes, base64. Generate with `openssl rand -base64 32`.
# Encrypts PDS-stored fields that need to stay private.
NUXT_PDS_ENCRYPTION_KEY=
