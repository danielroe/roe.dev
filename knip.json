{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "content.config.ts",
    "lexicons.ts",
    "server/utils/**/*.ts"
  ],
  "ignore": [
    "shared/lex/**"
  ],
  "ignoreDependencies": [
    "@iconify-json/ri",
    "@iconify-json/svg-spinners",
    "@iconify-json/tabler",
    "@nuxt/devtools",
    "bsky-runtime-discovery-server.mjs",
    "lru-cache",
    "nuxt-nightly",
    "postcss-nesting",
    "rollup-plugin-node-polyfills",
    "scule"
  ],
  "ignoreUnresolved": [
    "#content-manifest",
    "#md-page-meta"
  ],
  "ignoreIssues": {
    "content.config.ts": [
      "duplicates"
    ]
  }
}
